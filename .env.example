# Copy to .env.local for local work. On Cloudflare, add these under Worker > Settings > Variables and secrets (and as Build variables).
# NEVER commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key
ADMIN_EMAILS=toyscloudy@gmail.com
RESEND_API_KEY=your-resend-api-key
ADMIN_NOTIFICATION_EMAIL=toyscloudy@gmail.com
EMAIL_FROM=toyscloudy@gmail.com
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Optional fallback for the Contact/Cart Telegram button (normally set in Admin > Settings)
NEXT_PUBLIC_TELEGRAM_URL=
# Bakong/KHQR (not used yet)
BAKONG_PROVIDER_API_URL=
BAKONG_MERCHANT_ID=
BAKONG_API_KEY=
BAKONG_WEBHOOK_SECRET=
